{
  "name": "sberact-document-generator",
  "version": "1.0.0",
  "description": "Генератор судебных актов на основе заявлений для Astra Linux",
  "main": "electron-app/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "cross-env BROWSER=none npm --prefix electron-app start",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "cd electron-app && npm run build",
    "pack:backend": "python-backend\\venv\\Scripts\\pyinstaller.exe --noconfirm SberAct.spec",
    "pack:converter": "powershell -ExecutionPolicy Bypass -File scripts/assemble-converter.ps1",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.sberact.documentgenerator",
    "productName": "SberAct Document Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-app/build/**/*",
      "electron-app/main.js",
      "electron-app/preload.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "dist/SberAct",
        "to": "backend"
      },
      {
        "from": "converter",
        "to": "converter",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!**/*.log",
          "!pdf_to_convert/**",
          "!tests/**",
          "!models/*.part*"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "Генератор судебных актов на основе заявлений",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "electron",
    "react",
    "document-generation",
    "legal-documents",
    "astra-linux"
  ],
  "author": "SberAct Team",
  "license": "MIT"
}
